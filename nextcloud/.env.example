################################################################################
# 🔒 CrowdSec + Nextcloud - Configuration d'environnement
################################################################################
# ⚠️  IMPORTANT : Ne pas committer ce fichier avec des valeurs réelles dans Git !
# ⚠️  IMPORTANT : Utiliser des mots de passe forts et uniques pour chaque déploiement
################################################################################

# ========== 🗄️ BASE DE DONNÉES MARIADB ==========

# Nom de la base de données Nextcloud
MYSQL_DATABASE=nextcloud

# Utilisateur administrateur de MariaDB
# (Attention : ne pas changer après le premier démarrage)
MARIADB_ROOT_USER=theAdmin

# Mot de passe root de MariaDB
# ⚠️  Utiliser un mot de passe fort et complexe !
MARIADB_ROOT_PASSWORD=veryStrongPassword

# Utilisateur Nextcloud (accès à la BD)
MYSQL_USER=nextcloud

# Mot de passe de l'utilisateur Nextcloud
# ⚠️  Utiliser un mot de passe fort et complexe !
MYSQL_PASSWORD=verySecurePassword

# ========== 🌐 DOMAINE ET RÉSEAU ==========

# Domaine ou IP d'accès à Nextcloud
# Exemples : nextcloud.example.com, 192.168.1.100, cloud.mon-domaine.fr
# ⚠️  Doit correspondre aux DNS pointant vers le serveur
HOSTNAME=ip.or.domain

# ========== ☁️ CONFIGURATION NEXTCLOUD ==========

# Utilisateur administrateur Nextcloud (créé lors de l'initialisation)
NEXTCLOUD_ADMIN_USER=admin

# Mot de passe administrateur Nextcloud
# ⚠️  Utiliser un mot de passe fort et complexe !
NEXTCLOUD_ADMIN_PASSWORD=verySecurePassword

# ========== 🔧 CONFIGURATION SYSTÈME ==========

# Fuseau horaire
# Exemples : Europe/Paris, America/New_York, Asia/Tokyo
TZ=Europe/Paris

# ID utilisateur pour les conteneurs (évite les problèmes de permissions)
# Défaut : 1000 (utilisateur standard)
GID=1000

# ========== 📧 CERTBOT / SSL ==========

# Email pour les notifications Let's Encrypt
# Utilisé pour le renouvellement des certificats
CERTBOT_EMAIL=admin@example.com

# Mode de renouvellement des certificats (production ou staging)
# - production : certificats valides (limite : 50/semaine)
# - staging : certificats de test (sans limite, utiliser pour les tests)
CERTBOT_MODE=production

# ========== 🛡️ CROWDSEC ==========

# Collections CrowdSec à installer
# Format : "crowdsecurity/nom1 crowdsecurity/nom2"
# Collections disponibles :
#   - crowdsecurity/linux        : Protection système Linux
#   - crowdsecurity/sshd         : Protection SSH
#   - crowdsecurity/nginx        : Protection Nginx/Web
#   - crowdsecurity/http-cve     : Détection de CVE HTTP
#   - crowdsecurity/base-http-scenarios : Scénarios HTTP basiques
#   - crowdsecurity/nextcloud    : Détection Nextcloud
CROWDSEC_COLLECTIONS=crowdsecurity/linux crowdsecurity/sshd crowdsecurity/nginx crowdsecurity/http-cve crowdsecurity/base-http-scenarios crowdsecurity/nextcloud

# Scénarios CrowdSec personnalisés à charger
# Format : "nom1 nom2"
CROWDSEC_SCENARIOS=nextcloud-bf

# Niveau de log CrowdSec (info, debug, warning, error)
CROWDSEC_LOG_LEVEL=info

# ========== 🔐 SÉCURITÉ NGINX / OPENRESTY ==========

# Taille maximale des uploads
# Exemples : 100M, 500M, 1G
NGINX_MAX_UPLOAD_SIZE=500M

# Timeout des connexions (en secondes)
NGINX_PROXY_TIMEOUT=300

# Nombre maximum de connexions simultanées
NGINX_WORKER_CONNECTIONS=4096

# ========== 📊 REDIS / CACHE ==========

# Politique d'expiration du cache Redis
# Exemples : allkeys-lru, volatile-lru, allkeys-random
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Mémoire maximale Redis (en MB)
REDIS_MAXMEMORY=256

# ========== 🔄 BACKUP / MAINTENANCE ==========

# Heure de sauvegarde automatique (HH:MM au format 24h)
# Exemple : 02:00 = 2h du matin
BACKUP_TIME=02:00

# Retention des sauvegardes (en jours)
BACKUP_RETENTION=7

# ========== 📡 SERVICES EXTERNES (optionnel) ==========

# SMTP pour les notifications email Nextcloud
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASSWORD=emailPassword
SMTP_FROM=nextcloud@example.com

# S3 / Stockage objet (si utilisé)
# S3_ENDPOINT=https://s3.example.com
# S3_ACCESS_KEY=accessKey
# S3_SECRET_KEY=secretKey
# S3_BUCKET=nextcloud-backup

# ========== 🔬 DEBUG / DÉVELOPPEMENT ==========

# Activer le mode debug Nextcloud (production = false)
NEXTCLOUD_DEBUG=false

# Activer le mode debug Nginx (production = false)
NGINX_DEBUG=false

# Activer le mode debug CrowdSec (production = false)
CROWDSEC_DEBUG=false

################################################################################
# Notes importantes :
# 1. Générer des mots de passe forts : openssl rand -base64 32
# 2. Garder ce fichier sécurisé (permissions 0600)
# 3. Ne jamais committer les valeurs réelles dans Git
# 4. Différents mots de passe pour chaque déploiement (dev, staging, prod)
# 5. Rotation des mots de passe tous les 90 jours recommandée
################################################################################